# =============================================================================
# Docker Build Context Exclusions
# =============================================================================

# Version control
.git
.gitignore

# IDE / Editor
.vscode
.idea
*.swp
*.swo

# Environment & secrets
.env
.env.*
**/.env
**/.env.*
web/backend/config.json
web/frontend/.env
web/frontend/.env.*

# Build and tool caches
.gocache/
_tmp_*

# Local legacy artifacts left from the pre-monorepo layout
backend/
frontend/

# Agent and docs are built as separate artifacts, not part of the Web image
agent/
docs/
doc/

# Database files
*.db
*.db-shm
*.db-wal

# Documentation
*.md
LICENSE

# Dependencies and build artifacts
node_modules/
web/frontend/node_modules/
web/frontend/dist/
web/backend/bin/
web/backend/data/
web/backend/*.exe
web/backend/server
web/backend/mt-monitoring
agent/everyup-agent
agent/everyup-agent.exe

# OS files
.DS_Store
Thumbs.db

# Claude / dev tools
.claude/
.agent/
