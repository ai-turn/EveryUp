EVERYUP_AGENT_NAME=everyup-agent
EVERYUP_SERVICE_NAME=my-service
EVERYUP_DATA_DIR=/data
EVERYUP_HEALTH_URL=http://my-service:8080/health
EVERYUP_CHECK_INTERVAL_SECONDS=30
EVERYUP_HTTP_TIMEOUT_SECONDS=5
EVERYUP_ALERT_COOLDOWN_SECONDS=300
EVERYUP_DOCKER_DISCOVERY_ENABLED=true
EVERYUP_DOCKER_SOCKET_PATH=/var/run/docker.sock

EVERYUP_OTEL_CONFIG_ENABLED=false
EVERYUP_OTEL_CONFIG_PATH=/etc/everyup/generated/otel-config.yaml
EVERYUP_OTEL_CONF_DIR=/etc/everyup/conf.d
EVERYUP_OTEL_FILELOG_PATHS=/var/lib/docker/containers/*/*.log
EVERYUP_WEB_OTLP_ENDPOINT=
EVERYUP_WEB_API_KEY=
EVERYUP_WEB_SYNC_ENABLED=false
EVERYUP_WEB_BASE_URL=
EVERYUP_WEB_ENROLLMENT_TOKEN=
EVERYUP_WEB_AGENT_ID=
EVERYUP_WEB_SYNC_INTERVAL_SECONDS=30

EVERYUP_LLM_BASE_URL=
EVERYUP_LLM_API_KEY=
EVERYUP_LLM_MODEL=
EVERYUP_LLM_TIMEOUT_SECONDS=8
EVERYUP_LLM_MAX_TOKENS=500

EVERYUP_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
EVERYUP_TELEGRAM_CHAT_IDS=123456789
EVERYUP_CHATOPS_ENABLED=true

EVERYUP_RUNBOOK_ENABLED=true
EVERYUP_RUNBOOK_DIR=/etc/everyup/runbooks

EVERYUP_HEARTBEAT_URL=
EVERYUP_HEARTBEAT_TOKEN=
EVERYUP_HEARTBEAT_INTERVAL_SECONDS=60

EVERYUP_MEMORY_ENABLED=true
EVERYUP_MEMORY_PATH=/data/incident-memory.db

EVERYUP_HOST_METRICS_ENABLED=true
EVERYUP_HOST_METRICS_ROOT=/hostfs
EVERYUP_HOST_DISK_PATH=/hostfs
EVERYUP_HOST_CPU_PERCENT=90
EVERYUP_HOST_MEMORY_PERCENT=90
EVERYUP_HOST_DISK_PERCENT=85

EVERYUP_ACTIONS_ENABLED=false
EVERYUP_ACTION_DRY_RUN=true
EVERYUP_ACTION_ALLOWLIST=restart
EVERYUP_ACTION_CONFIRM_TTL_SECONDS=300
