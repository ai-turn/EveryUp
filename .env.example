# Copy this file to .env before running Docker Compose when you need overrides.

# Server
EVERYUP_SERVER_MODE=production
# EVERYUP_SERVER_PORT=3001
# EVERYUP_SERVER_ALLOWORIGINS=https://your-domain.com

# Admin account: leave unset for browser setup. Setting both values seeds or resets it on startup.
# EVERYUP_ADMIN_USERNAME=admin
# EVERYUP_ADMIN_PASSWORD=changeme-use-strong-password

# Storage
# EVERYUP_DATABASE_PATH=./data/monitoring.db
# Optional 64-character hex key. Keep it with deployment secrets and backups.
# EVERYUP_ENCRYPTION_KEY=

# EveryUp Agent connected-mode (optional).
# 1. Open the Web dashboard → Services → 추가하기 (Add)
# 2. Name the service and copy the generated API key (evup_svc_...)
# 3. Set the key in your agent's .env:
#    EVERYUP_AGENT_API_KEY=evup_svc_...
#    EVERYUP_WEB_SYNC_ENABLED=true
#    EVERYUP_WEB_BASE_URL=http://this-server:3001

# Agent: Telegram notifications (required by everyup-agent)
# EVERYUP_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# EVERYUP_TELEGRAM_CHAT_IDS=123456789

# Agent optional overrides (see agent/.env.example for full list)
# EVERYUP_AGENT_NAME=everyup-agent
# EVERYUP_SERVICE_NAME=my-service
# EVERYUP_HEALTH_URL=http://my-service:8080/health

# Timezone
TZ=Asia/Seoul
