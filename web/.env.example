# EveryUp Web — copy this file to .env to override defaults, then run Compose.
# Every value here is optional; the dashboard runs with sensible defaults.

# Server
EVERYUP_SERVER_MODE=production
# EVERYUP_SERVER_PORT=3001
# EVERYUP_SERVER_ALLOWORIGINS=https://your-domain.com

# Admin account: leave unset for browser setup on first visit.
# Setting both values seeds (or resets) the admin on startup.
# EVERYUP_ADMIN_USERNAME=admin
# EVERYUP_ADMIN_PASSWORD=changeme-use-strong-password

# Storage
# EVERYUP_DATABASE_PATH=./data/monitoring.db
# Optional 64-character hex key. Keep it with your deployment secrets and backups.
# EVERYUP_ENCRYPTION_KEY=

# Timezone
TZ=Asia/Seoul
